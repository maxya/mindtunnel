{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": 1,
      "type": "integer"
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,31}(?![\\s\\S])",
            "not": {
              "enum": [
                "value",
                "count"
              ]
            }
          },
          "type": {
            "enum": [
              "string",
              "integer"
            ]
          }
        },
        "required": [
          "id",
          "type"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "fields"
  ],
  "additionalProperties": false
}
