{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": 1,
      "type": "integer"
    },
    "rows": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "properties": {
          "group": {
            "type": [
              "null",
              "string"
            ],
            "maxLength": 4096
          },
          "value": {
            "type": "integer"
          }
        },
        "required": [
          "group",
          "value"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "rows"
  ],
  "additionalProperties": false
}
