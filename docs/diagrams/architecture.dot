digraph G {graph [rankdir=LR, bgcolor="white", pad=.2, nodesep=.35, ranksep=.55, fontname="Helvetica", label="MindTunnel · one-way planning boundary", labelloc=t, fontsize=18]; node [shape=box, style="rounded,filled", fontname="Helvetica", color="#47617A", fillcolor="#F0F5FA", margin=".17,.12"]; edge [fontname="Helvetica", fontsize=10, color="#526D82"]; subgraph cluster_pub { label="PUBLIC · deliberately authored"; color="#A8BCCF"; contract [label="Public aliases + types"]; task [label="Public task"]; request [label="Exact request preview"]; contract -> request; task -> request; } planner [label="Chosen planner
local or cloud", fillcolor="#FFF1DC", color="#B77B28"]; validator [label="Strict plan validator"]; request -> planner [label="explicit transfer"]; planner -> validator [label="untrusted JSON plan"]; contract -> validator; subgraph cluster_priv {label="PRIVATE · owner machine"; color="#5C967F"; mapping [label="Local CSV + mapping", fillcolor="#E7F5EC"]; executor [label="Bounded interpreter", fillcolor="#E7F5EC"]; out [label="Local result only", fillcolor="#E7F5EC"]; mapping -> executor; executor -> out;} validator -> executor; note [shape=note, label="No private result or error
